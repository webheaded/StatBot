{
  "Discord": {
    "Token": "",
    "DebugChannelId": "",
    "Commands": {
      "Prefix": "!",
      "Exclude": "excludefromstats",
      "Include": "includeinstats",
      "Stats": {
        "Command": "stats",
        "Url": ""
      },
      "AdminCommands": {
        "AdminUserId": 0,
        "AllowServerAdmins": false,
        "LinkUserCommand": "linkuser",
        "OverrideUsernameCommand": "overrideuser",
        "CreateOldUserCommand": "createolduser",
        "RemoveOverrideUsernameCommand": "removeoverrideuser"
      }
    }
  },
  "mIRCStats": {
    //The path where mircstats is located. Required for the include and exclude from stats commands. On Windows, every backslash has to be escaped with a backslash. E.g. C:\mircstats would be c:\\mircstats. On Linux, use a path like /opt/statbot/mircstats.
    "Path": "",
    "NicksFile": "nicks.txt",
    "NickSection": "[common]",
    //Leave value empty if you don't want to use it. On Windows, every backslash has to be escaped with a backslash. E.g. C:\mircstats would be c:\\mircstats. On Linux, use an executable script like /opt/statbot/mircstats/generate-stats.sh.
    "GeneratorFile": "C:\\Discord\\Statbot\\mircstats\\Generate Stats.bat",
    //If true, it will wait until the generation of the stats is completed and then start the timer for LaunchEveryMinutes. If false, it will start a timer after starting generating, even if it is still running (which may cause multiple stats being generated at the same time).
    "WaitUntilCompleted": true,
    //Delay until the stats will be generated again.
    "LaunchEveryMinutes": 15
  },
  "Application": {
    // 	Valid options: 
    //  channelid
    //  channelname
    //  single
    "LoggingFileName": "channelid",
    "NotificationDelay": 30000,
    //After a reconnect, restart the connection if no message arrives within this many ms (0 = off).
    "DeadChatAfter": 43200000,
    "PushOver": {
      //Leave values empty if you don't want to use it.
      "ApiKey": "",
      "UserKey": ""
    },
    //If true, will generate the nicks file automatically before generating the stats, if StatBot isn't handling generating the stats, it will do it every 30 minutes.
    "CreateNicksFileAutomatically": true,
    "ShowDiscrim": false,
    "ShowAvatar": true,
    //Fill in a filename for extra names to manually set values for, this can be used for for example setting MODE=ISEXCLUDED for banned users.
    "NicksFileManual": "",
    //The folder the channel logs are stored in, one subfolder per server. Leave empty to use the folder StatBot runs from. On Windows, every backslash has to be escaped with a backslash. E.g. C:\Discord\StatBot would be c:\\Discord\\StatBot. On Linux, use a path like /home/user/statbot-logs.
    "LogPath": ""
  }
}
